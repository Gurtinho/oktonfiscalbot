# Banco de dados / Auth (Supabase — self-hosted ou cloud)
VITE_SUPABASE_URL=https://xxxxx.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=
VITE_SUPABASE_PROJECT_ID=
SUPABASE_URL=https://xxxxx.supabase.co
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# IA (opcional — usada apenas para explicar rejeições fiscais)
# Compatível com OpenAI, OpenRouter, Groq, Together, vLLM próprio...
AI_API_KEY=
AI_BASE_URL=https://api.openai.com/v1
AI_MODEL=gpt-4o-mini

# Servidor
PORT=8080
# Preset de build do Nitro: node-server (padrão), bun, deno-server, etc.
NITRO_PRESET=node-server
